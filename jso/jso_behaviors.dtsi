#define JSO_HOLD_TAP(NAME, TAP_1, TAP_2) \
/ { \
  behaviors { \
    NAME: NAME { \
      compatible = "zmk,behavior-hold-tap"; \
      #binding-cells = <2>; \
      tapping-term-ms = <U_TAPPING_TERM>; \
      flavor = "tap-preferred"; \
      bindings = <TAP_1>, <TAP_2>; \
    }; \
  }; \
};

#define JSO_HOME_ROW(NAME, ...) \
/ { \
  behaviors { \
    NAME: NAME { \
      compatible = "zmk,behavior-hold-tap"; \
      #binding-cells = <2>; \
      flavor = "balanced"; \
      require-prior-idle-ms = <150>; \
      tapping-term-ms = <280>; \
      quick-tap-ms = <175>; \
      bindings = <&kp>, <&kp>; \
      hold-trigger-key-positions = <__VA_ARGS__>; \
      hold-trigger-on-release; \
    }; \
  }; \
};

#define JSO_MOD_MORPH(NAME, MOD, TAP_1, TAP_2) \
/ { \
  behaviors { \
    NAME: NAME { \
      compatible = "zmk,behavior-mod-morph"; \
      #binding-cells = <0>; \
      bindings = <&kp TAP_1>, <&kp TAP_2>; \
      mods = <MOD>; \
    }; \
  }; \
};

#define JSO_MOD_MT(NAME,TAP_1, TAP_2) \
JSO_MOD_MORPH(NAME, (MOD_LSFT|MOD_RSFT), TAP_1, TAP_2)

JSO_HOLD_TAP(b_mt, &kp, &kp)
JSO_HOLD_TAP(b_lt, &mo, &kp)

JSO_HOME_ROW(b_hr_left, 6, 7, 8, 9, 10, 11, 18, 19, 20, 21, 22, 23, 30, 31, 32, 33, 34, 35, 39, 40, 41)
JSO_HOME_ROW(b_hr_right, 0, 1, 2, 3, 4, 5, 12, 13, 14, 15, 16, 17, 24, 25, 26, 27, 28, 29, 36, 37, 38)

JSO_MOD_MT(slash_lt, FSLH, LT)
JSO_MOD_MT(dot_gt, FSLH, GT)
JSO_MOD_MT(colon_qmark, COLON, QMARK)
JSO_MOD_MT(comma_semi, COMMA, SEMI)