
/ {
    keymap {
        compatible = "zmk,keymap";

        numeric {
            // -----------------------------------------------------------------------------------------
            // |      |  [  |  6  |  7  |  9  |  ]  |           |     |     |     |     |     |      |
            // |      |  ;  |  4  |  5  |  6  |  =  |           |     | SFT | CTR | ALT | GUI |      |
            // |      |  `  |  1  |  2  |  3  |  \  |           |     |     |     |     |     |      |
            //                    |  .  |  0  |  -  |           |     |     |     |

            display-name = "NUM";
            bindings = <
&none  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBRK     &none  TO_BASE    TO_ALTER   TO_EXTRA  TO_OPT      &none 
&none  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI    &none 
&none  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BLSH     &none  TO_NUM     TO_NAV     &none     TO_NUM_ALT  &none 
                          &kp DOT  &kp N0  &kp MINUS    &none  &none      &none
            >;
        };
    };
};
