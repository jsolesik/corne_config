
/ {
    keymap {
        compatible = "zmk,keymap";

        numeric {
            // -----------------------------------------------------------------------------------------
            // |      |  [  |  6  |  7  |  9  |  ]  |           |     |     |     |     |     |      |
            // |      |  ;  |  4  |  5  |  6  |  =  |           |     | SFT | CTR | ALT | GUI |      |
            // |      |  `  |  1  |  2  |  3  |  \  |           |     |     |     |     |     |      |
            //                    |  .  |  0  |  -  |           |     |     |     |

            display-name = "NUM";
            bindings = <
&none  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBRK     &none  &b_to_L_BASE  &b_to_L_ALTER &b_to_L_EXTRA &b_to_L_OPT      &none 
&none  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &none  &kp RSHFT     &kp RCTRL     &kp RALT      &kp RGUI         &none 
&none  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BLSH     &none  &b_to_L_NUM   &b_to_L_NAV   &none         &b_to_L_NUM_REV  &none 
                          &kp DOT  &kp N0  &kp MINUS    &none  &none         &none
            >;
        };
    };
};
