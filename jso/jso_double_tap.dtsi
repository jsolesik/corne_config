#define JSO_DOUBLE_TAP(NAME, TAP) \
/ { \
  behaviors { \
    NAME: NAME { \
      compatible = "zmk,behavior-tap-dance"; \
      #binding-cells = <0>; \
      tapping-term-ms = <250>; \
      bindings = <&none>, <TAP>; \
    }; \
  }; \
};

#define JSO_X(LAYER, NAME) \
JSO_DOUBLE_TAP(b_to_L_##LAYER, &to L_##LAYER)
JSO_LAYER_LIST
#undef JSO_X

//JSO_DOUBLE_TAP_SAFE(b_soft_off, &soft_off)
JSO_DOUBLE_TAP(b_bootloader, &bootloader)

