#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 25
#define BASE    0
#define QWERTY  1
#define MTGAP   2
#define NUM     3
#define SYM     4
#define FUNC    5
#define NAV     6
#define MOUSE   7
#define MEDIA   8
#define LOWER   9
#define RAISE   10
#define ADJUST   11

/ {
    macros {
        CtrlAltDel: CtrlAltDel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LALT &kp DEL>;
            label = "CTRLALTDEL";
        };

        win_screenshot: win_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI &kp LSHFT &kp S>;
            label = "WIN_SCREENSHOT";
        };
    };

    behaviors {
        HRL: HRL {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <36 37 38 39 6 20 19 31 32 30 18 40 41 7 8 9 21 33 34 35 23 22 10 11>;
        };

        HRR: HRR {
            compatible = "zmk,behavior-hold-tap";
            label = "HRR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <36 37 38 39 41 39 41 40 0 1 2 12 13 14 24 25 26 16 17 3 4 5 15 16 17 27 28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_layer { //0 COLEMAK mod DHK
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  ;  | BSPC |
            // | BKSP |  A  |  R  |  S  |  T  |  G  |   |  K  |  N   |  E  |  I  |  O  |  '   |
            // |   |  |  Z  |  X  |  C  |  D  |  V  |   |  M  |  H   |  ,  |  .  |  /  | ESC  |
            //                    | ESC | SPC | TAB |   | ENT | BSPC | DEL |

            display-name = "Base";
            bindings = <
&kp TAB   &kp Q        &kp W        &kp F         &kp P         &kp B        &kp J        &kp L         &kp U         &kp Y        &kp SEMI     &kp BSPC
&kp BSPC  &HRL LGUI A  &HRL LALT R  &HRL LCTRL S  &HRL LSHFT T  &kp G        &kp K        &HRR RSHFT N  &HRR RCTRL E  &HRR RALT I  &HRR RGUI O  &kp SQT
&kp PIPE  &kp Z        &kp X        &kp C         &kp D         &kp V        &kp M        &kp H         &kp COMMA     &kp DOT      &kp FSLH     &kp ESC
                                    &lt MEDIA ESC       &lt NAV SPACE     &lt MOUSE TAB    &lt SYM ENTER  &lt NAV BSPC      &lt FUNC DEL
            >;
        };

        qwerty_layer { //1
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &HRL LGUI A  &HRL LALT S  &HRL LCTRL D  &HRL LSHFT F  &kp G        &kp H        &HRR RSHFT J  &HRR RCTRL K  &HRR RALT L  &HRR RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo LOWER  &kp SPACE    &kp RET  &mo RAISE  &kp RALT
            >;
        };

        mtgap_layer { //2
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Y  |  P  |  O  |  U  |  J  |   |  K  |  D   |  L  |  C  |  W  | BKSP |
            // | CTRL |  I  |  N  |  E  |  A  |  ,  |   |  M  |  H   |  T  |  S  |  R  |  '   |
            // | SHFT |  Q  |  Z  |  /  |  .  |  :  |   |  B  |  F   |  G  |  V  |  X  | ESC  |
            //                    | ESC | SPC | TAB |   | ENT | BSPC | DEL |

            display-name = "MTGAP";
            bindings = <
&kp TAB   &kp Y        &kp P        &kp O         &kp U         &kp J           &kp K    &kp D         &kp L         &kp C        &kp W        &kp BSPC
&kp BSPC  &HRL LGUI I  &HRL LALT N  &HRL LCTRL E  &HRL LSHFT A  &kp COMMA       &kp M    &HRR RSHFT H  &HRR RCTRL T  &HRR RALT S  &HRR RGUI R  &kp SQT
&kp PIPE  &kp Q        &kp Z        &kp SLASH     &kp DOT       &kp LS(SEMI)    &kp B    &kp F         &kp G         &kp V        &kp X        &kp ESC
                                    &lt MEDIA ESC       &lt NAV SPACE     &lt MOUSE TAB    &lt SYM ENTER  &lt NAV BSPC      &lt FUNC DEL
            >;
        };

        numeric_layer { //3
            // -----------------------------------------------------------------------------------------
            // |  TAB |  [  |  6  |  7  |  9  |  ]  |   |     |     |     |     |     |      |
            // |      |  ;  |  4  |  5  |  6  |  =  |   |     | SFT | CTR | ALT | GUI |      |
            // |      |  `  |  1  |  2  |  3  |  \  |   |     |     |     |     |     |      |
            //                    |  .  |  0  |  -  |   |     |     |     |

            display-name = "NUM";
            bindings = <
&none  &kp LBKT   &kp N7  &kp N8  &kp N9   &kp RBRK      &none &none &none   &none  &none  &kp BSPC
&none  &kp SEMI   &kp N4  &kp N5  &kp N6   &kp EQUAL     &none  &HRR RSHFT J  &HRR RCTRL K  &HRR RALT L  &HRR RGUI SEMI  &kp RET 
&none  &kp GRAVE  &kp N1  &kp N2  &kp N3   &kp BLSH      &none  &none  &none   &none  &none  &kp ESC
                          &kp DOT  &kp N0  &kp MINUS     &none  &none  &none
            >;
        };

        symbols_layer { //4
            display-name = "SYMBOLS";
            bindings = <
&none  &kp LBRC   &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RBRC     &none &none &none   &none  &none  &kp BSPC
&none  &kp PLUS   &kp DOLLAR     &kp PERCENT   &kp CARET             &kp PLUS     &none  &HRR RSHFT J  &HRR RCTRL K  &HRR RALT L  &HRR RGUI SEMI  &kp RET 
&none  &kp TILDE  &kp EXCL       &kp AT        &kp HASH              &kp PIPE     &none  &none  &none   &none  &none  &kp ESC
                           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &none  &none  &none
            >;
        };

        functions_layer { //5
            display-name = "FUNC";
            bindings = <
&kp K_SCREENSAVER  &kp F12  &kp F7  &kp F8  &kp F9   &kp PRINTSCREEN    &none &none &none   &none  &none  &kp BSPC
&win_screenshot    &kp F11  &kp F4  &kp F5  &kp F6   &kp SCROLLLOCK     &none  &HRR RSHFT J  &HRR RCTRL K  &HRR RALT L  &HRR RGUI SEMI  &kp RET 
&CtrlAltDel        &kp F10  &kp F1  &kp F2  &kp F3   &kp PAUSE_BREAK    &none   &none  &none  &none  &none  &none
                                    &kp N0  &kp DOT  &kp SPACE          &none  &none  &none
            >;
        };

        navigation_layer { //6
            display-name = "NAV";
            bindings = <
&none  &none  &none  &none  &none  &none                                    &kp K_REDO    &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &none
&kp BSPC  &HRL LGUI A  &HRL LALT R  &HRL LCTRL S  &HRL LSHFT T  &none       &kp CAPSLOCK  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&none  &none  &none  &none  &none  &none                                    &kp INS       &kp HOME        &kp PG_DN       &kp PG_UP     &kp END          &none
                         &none  &none  &none                                &kp RET       &kp BSPC        &kp DEL
            >;
        };

        mouse_layer { //7
            display-name = "MOUSE";
            bindings = <
&none  &none  &none  &none  &none  &none                                    &kp K_REDO    &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &none
&kp BSPC  &HRL LGUI A  &HRL LALT R  &HRL LCTRL S  &HRL LSHFT T  &none       &none         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none  &none  &none  &none  &none                                    &none         &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                         &none  &none  &none                                &mkp M2       &mkp M1         &mkp M3
            >;
        };

        media_layer { //8
            display-name = "MEDIA";
            bindings = <
&none  &none  &none  &none  &none  &none                                    &none               &none         &kp C_BRI_DN  &kp C_BRI_UP  &none           &none
&kp BSPC  &HRL LGUI A  &HRL LALT R  &HRL LCTRL S  &HRL LSHFT T  &none       &ext_power EP_TOG   &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT           &none
&none  &none  &none  &none  &none  &none                                    &out OUT_TOG        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
                         &none  &none  &none                                &kp C_STOP          &kp C_PLAY_PAUSE     &kp C_MUTE
            >;
        };

        lower_layer { //9
            display-name = "LOWER";
            bindings = <
&kp ESC    &none                 &kp N7  &kp N8    &kp N9  &kp PAGE_UP      &kp LG(LS(J))      &kp LC(LS(TAB))  &kp LC(TAB)   &none         &none                 &kp DELETE
&kp LCTRL  &none                 &kp N4  &kp N5    &kp N6  &kp PAGE_DOWN    &kp LEFT           &kp DOWN         &kp UP        &kp RIGHT     &none                 &kp RET
&kp LSHFT  &kp LC(LS(LA(LGUI)))  &kp N1  &kp N2    &kp N3  &kp N0           &kp C_VOL_DN       &kp C_VOL_UP     &kp C_BRI_DN  &kp C_BRI_UP  &kp LC(LS(LA(LGUI)))  &kp LG(LSHFT)
                                         &kp LGUI  &mo LOWER   &kp SPACE        &kp LG(LA(SPACE))  &mo RAISE            &kp RALT
            >;
        };

        raise_layer { //10
            display-name = "RAISE";
            bindings = <
&kp GRAVE  &kp EXCL              &kp AT          &kp POUND             &kp DOLLAR        &kp PERCENT      &kp CARET          &kp AMPS           &kp STAR               &kp PLUS         &kp EQUAL             &kp MINUS
&kp LCTRL  &none                 &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp SQT          &kp DOUBLE_QUOTES  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp BACKSLASH         &kp RET
&kp LSHFT  &kp LC(LS(LA(LGUI)))  &none           &none                 &none             &none            &kp UNDER          &none              &none                  &none            &kp LC(LS(LA(LGUI)))  &kp RSHFT
                                                 &kp LGUI              &mo LOWER             &kp LC(SPACE)    &kp SPACE          &mo RAISE              &kp RALT
            >;
        };

        adjust_layer { //11
            display-name = "ADJUST";
            bindings = <
&kp LC(LA(F2))  &none                 &kp F7  &kp F8    &kp F9  &kp F12    &kp C_PP        &kp C_PREV      &kp C_NEXT    &none            &none                 &kp PRINTSCREEN
&none           &none                 &kp F4  &kp F5    &kp F6  &kp F11    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp RC(RALT)          &kp RCTRL
&none           &kp LC(LS(LA(LGUI)))  &kp F1  &kp F2    &kp F3  &kp F10    &kp C_RW        &kp C_FF        &none         &none            &kp LC(LS(LA(LGUI)))  &kp RC(RSHFT)
                                              &kp LGUI  &mo LOWER   &none      &none           &mo RAISE          &kp RALT
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_condition {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
};
